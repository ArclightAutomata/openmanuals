{
  "_doc": "Detection constants of the watermark stripper (crates/openmanuals-strip). Regexes are written in Python syntax; `on` says whether they match a latin-1 decoded str (Python str regex: \\s is Unicode whitespace) or raw bytes (ASCII \\s). Flags: s = DOTALL, i = IGNORECASE. Hashes are 64-bit difference hashes as hex strings.",
  "manualslib_footer": { "pattern": "q\\s*\\n0 0 \\d+ \\d+ re.*?manuals search engine.*?Q\\s*\\n?", "flags": "s", "on": "text" },
  "max_wrapper_pages": 40,
  "wkhtmltopdf_preamble": { "pattern": "^\\s*(?:q\\s+)?/GSa gs", "flags": "", "on": "text" },
  "third_party_stamp": { "pattern": "cxema\\.ru|esquemaseletricos\\.com\\.br|chinadse\\.org|all-guides\\.com", "flags": "i", "on": "bytes" },
  "stamp_text_object": { "pattern": "BT(?:(?!\\bET\\b).)*?(?:cxema\\.ru|esquemaseletricos\\.com\\.br|chinadse\\.org|all-guides\\.com)(?:(?!\\bET\\b).)*?ET\\s*", "flags": "si", "on": "bytes" },
  "max_stamp_form_bytes": 2000,
  "junk_cover_hashes": { "1da5d7e353d3a58e": "esquemaseletricos.com.br red advert page" },
  "junk_cover_max_distance": 10,
  "stamp_image_hashes": { "004565751939f2f2": "tecnicosaurios.com diagonal banner" },
  "stamp_image_max_distance": 8,
  "stamp_image_min_aspect": 6
}
